    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nlet formData = {};\nlet aiData = {};\n\nfor (const item of items) {\n  const data = item.json;\n\n  // Form data पहचानें\n  if (data.Email || data.email || data.company_name) {\n    formData = { ...formData, ...data };\n  }\n\n  // AI data पहचानें\n  if (data.lead_temperature !== undefined) {\n    aiData = { ...aiData, ...data };\n  }\n\n  // AI response अगर JSON string में है\n  if (typeof data.output === 'string') {\n    try {\n      const parsed = JSON.parse(data.output);\n      aiData = { ...aiData, ...parsed };\n    } catch (e) {}\n  }\n\n  // AI response अगर content.parts[0].text में है\n  const text = data.content?.parts?.[0]?.text;\n\n  if (typeof text === 'string') {\n    try {\n      const cleaned = text\n        .replace(/```json/gi, '')\n        .replace(/```/g, '')\n        .trim();\n\n      aiData = { ...aiData, ...JSON.parse(cleaned) };\n    } catch (e) {}\n  }\n}\n\nreturn [{\n  json: {\n    ...formData,\n    lead_temperature: aiData.lead_temperature ?? null,\n    priority: aiData.priority ?? null,\n    buying_intent: aiData.buying_intent ?? null,\n    budget_assessment: aiData.budget_assessment ?? null,\n    lead_score: aiData.lead_score ?? null,\n    missing_information: aiData.missing_information ?? null,\n    ai_summary: aiData.ai_summary ?? null,\n    recommended_action: aiData.recommended_action ?? null,\n    follow_up_timing: aiData.follow_up_timing ?? null,\n    follow_up_method: aiData.follow_up_method ?? null\n  }\n}];\n"
      },
